# ============================================================================
# .dockerignore for FinRAG Docker Builds
# Context: ModelPipeline/ (parent of finrag_docker_loc_tg1)
# Purpose: Exclude unnecessary files to reduce Docker image size and build time
# ============================================================================

# ============================================================================
# Git & Version Control
# ============================================================================
.git/
.gitignore
.github/
.dvc/
.dvcignore

# ============================================================================
# Python Artifacts
# ============================================================================
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.so
*.egg-info/
*.egg
.eggs/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# ============================================================================
# Virtual Environments (ALL of them)
# ============================================================================
venv/
.venv/
venv_*/
*/venv_*/
finrag_ml_tg1/venv_ml_rag/
serving/backend/venv_backend/
serving/frontend/venv_frontend/

# ============================================================================
# IDEs & Editors
# ============================================================================
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db

# ============================================================================
# Notebooks & Experiments (not needed in production containers)
# ============================================================================
*.ipynb
notebooks/
experiments/

MLFlow_POC/

# Platform core notebooks - MLinfra spine not needed here
finrag_ml_tg1/platform_core/
finrag_ml_tg1/validation_notebooks/

# Rag module source tests and isolation tests
finrag_ml_tg1/rag_modules_src/01_Isolation_Test_NBS/
finrag_ml_tg1/rag_modules_src/02_LLMEval_Notebooks/
finrag_ml_tg1/rag_modules_src/03_LambdaRefactor_Tests/

# ============================================================================
# Large Data Files (should be fetched from S3 at runtime, not baked into image)
# ============================================================================
*.csv
*.parquet
*.feather
*.h5
*.hdf5
*.pkl
*.pickle

# Data directories
data/
data_cache/
DataPipeline/
Edgar-Sentences-SDK/raw_data/

# The bare patterns above (and *.parquet etc.) are matched against the CONTEXT
# ROOT only - they do not recurse. finrag_ml_tg1/data_cache/ therefore slipped
# into the image on 2026-07-30 (harmless while empty, but it would have baked in
# the ~8.8GB of embedding/vector tables had they still been present locally).
# The **/ form is what actually recurses. Deliberately NOT globbing
# **/*.parquet: metric_pipeline/data/KPI_FACT_DATA_EDGAR.parquet (84KB) ships
# with the code and Supply Line 1 may read it directly.
**/data_cache/

# Stage 3 vtable, embed large table, analysis exports, trial data incr
finrag_ml_tg1/data_cache/embeddings/
finrag_ml_tg1/data_cache/stage3_s3vectors/
finrag_ml_tg1/data_cache/analysis_exports/
finrag_ml_tg1/data_cache/trial_data_incr/

# ============================================================================
# Model Weights (download from S3, not bake into image)
# ============================================================================
*.pt
*.pth
*.ckpt
*.safetensors
models/
checkpoints/

# ============================================================================
# Logs & Temporary Files
# ============================================================================
*.log
logs/
.log/

# ============================================================================
# Build Artifacts
# ============================================================================
dist/
build/
*.whl

# ============================================================================
# Lambda & Cloud Deployment Assets (not needed for Docker)
# ============================================================================
lambda_assets/
src_aws_etl/

# ============================================================================
# Sevalla & Demo Assets (deployment-specific, not for Docker image)
# ============================================================================
sevalla_assets/
finrag_ml_tg1/demo_images_export/

# ============================================================================
# Design & Documentation (not needed in runtime image)
# ============================================================================
design_docs/

# ============================================================================
# Testing (not needed in production containers)
# ============================================================================
tests/
test_*/
.coverage
htmlcov/

# ============================================================================
# Docker Files Themselves (prevent recursion)
# ============================================================================
finrag_docker_loc_tg1/
finrag_docker_loc_tg1_aws/
docker-compose.yml
*.Dockerfile

# ============================================================================
# Not part of the serving runtime
# ============================================================================
mlruns/
revival_scratch/
finrag_ml_tg2/

# ============================================================================
# Secrets & Environment Files (use env_file in docker-compose instead)
# ============================================================================
.env
.env.*
secrets.env

# NOTE: these patterns need the **/ prefix. A bare "aws_credentials.env" is
# matched against the context root only, so it did NOT exclude the real file at
# finrag_ml_tg1/.aws_secrets/aws_credentials.env - verified baked into an image
# layer on 2026-07-30. Credentials reach the container via docker-compose
# env_file instead (MLConfig._load_aws_credentials Priority 3, environment).
**/aws_credentials.env
**/.aws_secrets/

# ============================================================================